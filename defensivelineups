import React, { useMemo, useState } from "react";

/**
 * Minimal, single-file React app to generate equitable defensive lineups
 * for youth baseball (13 players, 9 positions, 6 innings by default).
 *
 * No external UI libs required. Tailwind classes are included; if you don't
 * use Tailwind, it's still readable.
 */

// ----- Types -----
type Position = "P" | "C" | "1B" | "2B" | "3B" | "SS" | "LF" | "CF" | "RF";
const INFIELD: Position[] = ["P", "C", "1B", "2B", "3B", "SS"];
const OUTFIELD: Position[] = ["LF", "CF", "RF"];
const ALL_POSITIONS: Position[] = [...INFIELD, ...OUTFIELD];

interface Player {
  id: string;
  name: string;
}

interface Assignment { inning: number; position: Position; playerId: string }
interface Bench { inning: number; playerIds: string[] }

interface LineupSolution {
  assignments: Assignment[];
  bench: Bench[];
  summary: {
    inningsPerPlayer: Record<string, number>;
    infieldOutfieldCoverage: Record<string, { infield: boolean; outfield: boolean }>;
    positionCounts: Record<string, Partial<Record<Position, number>>>;
    notices: string[];
    hardConstraintSatisfied: boolean;
  }
}

// ----- Utils -----
const hashString = (s: string) => {
  let h = 2166136261 >>> 0; // FNV-like simple hash
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
};

function sortDeterministic<T>(arr: T[], key: (t: T) => string): T[] {
  return [...arr].sort((a, b) => {
    const ha = hashString(key(a));
    const hb = hashString(key(b));
    return ha - hb;
  });
}

function chunk<T>(arr: T[], size: number): T[][] {
  const out: T[][] = [];
  for (let i = 0; i < arr.length; i += size) out.push(arr.slice(i, i + size));
  return out;
}

// Simple helper to pick N by lowest score with stable ordering
function pickLowest<T>(items: T[], n: number, score: (t: T) => number, tieKey: (t: T) => string): T[] {
  return [...items]
    .sort((a, b) => {
      const d = score(a) - score(b);
      if (d !== 0) return d;
      return hashString(tieKey(a)) - hashString(tieKey(b));
    })
    .slice(0, n);
}

